---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
---

<Base
  title="Page not found · Thierry Triet LAM"
  description="The page you are looking for does not exist."
>
  <Nav base="/" />
  <main class="container-content flex min-h-[62vh] flex-col items-center justify-center py-24 text-center">
    <p class="eyebrow mb-3">404</p>
    <h1 class="section-title">Page not found</h1>
    <p class="lead mt-4 max-w-md">
      Page introuvable. The page you are looking for does not exist or has moved.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn btn-primary">
        <Icon name="lucide:arrow-left" class="h-4 w-4" /> Back home
      </a>
      <a href="/fr/" class="btn btn-ghost">Version française</a>
    </div>
  </main>
  <Footer />
</Base>
