---
import { Icon } from "astro-icon/components";
import { getSite } from "../data/site";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

// Segmented CV download: label + divider + EN/FR chips, 44px tall (h-11),
// same radius as the primary button. The chip matching the site language is
// active; the main label downloads that language, the other chip is one tap away.
const lang = getLangFromUrl(Astro.url);
const site = getSite(lang);
const t = useTranslations(lang);

const primaryHref = lang === "fr" ? site.links.cvFr : site.links.cvEn;
const chips = [
  { code: "EN", href: site.links.cvEn },
  { code: "FR", href: site.links.cvFr },
] as const;
const activeChip =
  "rounded-lg bg-accent-soft px-2.5 py-1.5 font-mono text-xs font-semibold text-accent transition hover:bg-accent hover:text-white dark:bg-accent-dark/25 dark:text-accent-dark dark:hover:bg-accent-dark dark:hover:text-white";
const idleChip =
  "rounded-lg px-2.5 py-1.5 font-mono text-xs font-semibold text-muted transition hover:bg-accent-soft hover:text-accent dark:text-dark-muted dark:hover:bg-dark-bg dark:hover:text-accent-dark";
---

<div
  class="inline-flex h-11 items-center rounded-xl border border-line bg-white pl-4 pr-1.5 shadow-card dark:border-dark-line dark:bg-dark-surface"
>
  <a
    href={primaryHref}
    download
    class="inline-flex h-full items-center gap-2 text-sm font-semibold text-ink transition hover:text-accent dark:text-dark-text dark:hover:text-accent-dark"
  >
    <Icon name="lucide:download" class="h-4 w-4" />
    {t("hero.downloadCV")}
  </a>
  <span class="mx-3 h-5 w-px bg-line dark:bg-dark-line" aria-hidden="true"></span>
  <span class="flex items-center gap-1">
    {
      chips.map((c) => (
        <a
          href={c.href}
          download
          aria-label={`${t("hero.downloadCV")} (${c.code})`}
          class={c.code.toLowerCase() === lang ? activeChip : idleChip}
        >
          {c.code}
        </a>
      ))
    }
  </span>
</div>
