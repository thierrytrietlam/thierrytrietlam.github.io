---
import { Icon } from "astro-icon/components";
import { getValueCards } from "../data/value";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const cards = getValueCards(lang);
const t = useTranslations(lang);
---

<section id="value" class="border-t border-line py-20 sm:py-24 dark:border-dark-line">
  <div class="container-content">
    <div data-reveal>
      <p class="eyebrow mb-3">{t("value.eyebrow")}</p>
      <h2 class="section-title">{t("value.title")}</h2>
      <p class="lead mt-4 max-w-2xl">{t("value.lead")}</p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((c, i) => (
          <article class="card card-hover flex flex-col p-5" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
            <div class="flex items-center justify-between gap-3">
              <span class:list={["flex h-10 w-10 shrink-0 items-center justify-center rounded-xl", c.chip]}>
                <Icon name={c.icon} class="h-5 w-5" />
              </span>
              <span class="font-mono text-[0.62rem] uppercase tracking-widest text-muted dark:text-dark-muted">{c.kicker}</span>
            </div>
            <h3 class="mt-3.5 font-display text-base font-semibold text-ink dark:text-dark-text">{c.title}</h3>
            <p class="mb-4 mt-1.5 text-sm leading-relaxed text-muted dark:text-dark-muted">{c.body}</p>
            <p
              class:list={[
                "mt-auto flex items-start gap-1.5 border-t border-line pt-3.5 font-mono text-xs font-semibold leading-relaxed dark:border-dark-line",
                c.metricColor,
              ]}
            >
              <Icon name="lucide:trending-up" class="mt-0.5 h-3.5 w-3.5 shrink-0" />
              {c.metric}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
