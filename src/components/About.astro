---
import { Icon } from "astro-icon/components";
import WorldMap from "./WorldMap.astro";
import { getSite } from "../data/site";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const site = getSite(lang);
const t = useTranslations(lang);

const facts: { icon: string; label: string; value: string; href?: string }[] = [
  { icon: "lucide:map-pin", label: t("about.location"), value: site.location },
  { icon: "lucide:briefcase", label: t("about.experience"), value: site.yearsExperience },
  { icon: "lucide:calendar-clock", label: t("about.book"), value: t("book.call"), href: site.calendly },
  { icon: "lucide:languages", label: t("about.languages"), value: site.languages.join(", ") },
];
---

<section id="about" class="border-t border-line py-20 sm:py-24 dark:border-dark-line">
  <div class="container-content grid gap-12 md:grid-cols-2 md:gap-16">
    <div data-reveal>
      <p class="eyebrow mb-3">{t("about.eyebrow")}</p>
      <h2 class="section-title">{t("about.title")}</h2>
      <div class="mt-6 space-y-4 text-base leading-relaxed text-muted dark:text-dark-muted">
        <p>{site.aboutLead}</p>
        <p>{site.aboutClose}</p>
      </div>
    </div>
    <div class="md:content-start">
      <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2" data-reveal style="--reveal-delay:80ms">
        {
          facts.map((f) => (
            <div class="card p-4">
              <dt class="flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-widest text-muted dark:text-dark-muted">
                <Icon name={f.icon} class="h-4 w-4 text-accent dark:text-accent-dark" />
                {f.label}
              </dt>
              <dd class="mt-1.5 text-sm font-medium text-ink dark:text-dark-text">
                {
                  f.href ? (
                    <a
                      href={f.href}
                      target="_blank"
                      rel="noopener"
                      class="-my-2 inline-flex items-center gap-1 py-2 text-accent transition hover:underline dark:text-accent-dark"
                    >
                      {f.value}
                      <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5" />
                    </a>
                  ) : (
                    f.value
                  )
                }
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-3">
        <WorldMap />
      </div>
    </div>
  </div>
</section>
