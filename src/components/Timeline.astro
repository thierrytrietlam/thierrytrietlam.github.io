---
import { Icon } from "astro-icon/components";
import { getTimeline } from "../data/timeline";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";
import { logoSize } from "../data/logos";

const lang = getLangFromUrl(Astro.url);
const timeline = getTimeline(lang);
const tr = useTranslations(lang);
---

<section id="timeline" class="border-t border-line py-20 sm:py-24 dark:border-dark-line">
  <div class="container-content">
    <div data-reveal>
      <p class="eyebrow mb-3">{tr("timeline.eyebrow")}</p>
      <h2 class="section-title">{tr("timeline.title")}</h2>
    </div>

    <ol class="relative mt-10 max-w-3xl border-l border-line pl-8 dark:border-dark-line" data-reveal>
      {
        timeline.map((t) => (
          <li class="relative pb-8 last:pb-0">
            <span
              class={`absolute -left-[2.5rem] top-0.5 flex h-6 w-6 items-center justify-center rounded-full border bg-white dark:bg-dark-surface ${
                t.kind === "education"
                  ? "border-line text-muted dark:border-dark-line dark:text-dark-muted"
                  : "border-accent/40 text-accent dark:border-accent-dark/50 dark:text-accent-dark"
              }`}
            >
              <Icon name={t.kind === "education" ? "lucide:graduation-cap" : "lucide:briefcase"} class="h-3 w-3" />
            </span>
            <p class="font-mono text-xs text-muted dark:text-dark-muted">
              {t.period}
              {t.location ? ` · ${t.location}` : ""}
            </p>
            <h3 class="mt-1 font-display text-base font-semibold text-ink dark:text-dark-text">{t.title}</h3>
            {
              t.orgs && t.orgs.length ? (
                <div class="mt-1 space-y-1">
                  {t.orgs.map((o) => (
                    <div class="flex items-center gap-2">
                      {o.logo && (
                        <span class="flex h-6 items-center justify-center rounded border border-line bg-white px-1.5">
                          <img src={o.logo} alt={`${o.name} logo`} width={logoSize(o.logo)?.w} height={logoSize(o.logo)?.h} class="max-h-3.5 w-auto object-contain mix-blend-multiply" loading="lazy" />
                        </span>
                      )}
                      {o.url ? (
                        <a href={o.url} target="_blank" rel="noopener" class="text-sm font-medium text-accent hover:underline dark:text-accent-dark">
                          {o.name}
                        </a>
                      ) : (
                        <span class="text-sm font-medium text-accent dark:text-accent-dark">{o.name}</span>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                <div class="mt-0.5 flex items-center gap-2">
                  {t.logo && (
                    <span class="flex h-6 items-center justify-center rounded border border-line bg-white px-1.5">
                      <img
                        src={t.logo}
                        alt={`${t.org} logo`}
                        width={logoSize(t.logo)?.w}
                        height={logoSize(t.logo)?.h}
                        class="max-h-3.5 w-auto object-contain mix-blend-multiply"
                        loading="lazy"
                      />
                    </span>
                  )}
                  {t.url ? (
                    <a
                      href={t.url}
                      target="_blank"
                      rel="noopener"
                      class="text-sm font-medium text-accent hover:underline dark:text-accent-dark"
                    >
                      {t.org}
                    </a>
                  ) : (
                    <span class="text-sm font-medium text-accent dark:text-accent-dark">{t.org}</span>
                  )}
                </div>
              )
            }
            <p class="mt-1.5 text-sm leading-relaxed text-muted dark:text-dark-muted">{t.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
