---
import { Icon } from "astro-icon/components";
import type { Demo } from "../data/demos";

interface Props {
  demo: Demo;
}
const { demo } = Astro.props;
---

<article class="card card-hover flex flex-col overflow-hidden" data-reveal>
  <div class="relative aspect-[16/9] overflow-hidden border-b border-line dark:border-dark-line">
    {
      demo.image ? (
        <img
          src={demo.image}
          alt={`${demo.title} screenshot`}
          class="h-full w-full object-cover"
          width="640"
          height="360"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-accent-soft dark:bg-dark-bg">
          <div class="text-center">
            <Icon name="lucide:database" class="mx-auto h-8 w-8 text-accent dark:text-accent-dark" />
            <p class="mt-2 font-mono text-sm text-accent dark:text-accent-dark">{demo.title}</p>
          </div>
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="font-mono text-[0.7rem] uppercase tracking-widest text-muted dark:text-dark-muted">{demo.tagline}</p>
    <h3 class="mt-1 font-display text-lg font-semibold text-ink dark:text-dark-text">{demo.title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-muted dark:text-dark-muted">{demo.description}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        demo.stack.map((s) => (
          <li class="tag">
            {s.icon && <Icon name={s.icon} class="h-3.5 w-3.5" />}
            {s.name}
          </li>
        ))
      }
    </ul>
    {
      demo.links.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-4">
          {demo.links.map((l) => (
            <a
              href={l.url}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline dark:text-accent-dark"
            >
              {l.label} <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5" />
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
