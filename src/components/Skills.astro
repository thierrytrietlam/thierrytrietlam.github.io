---
import { Icon } from "astro-icon/components";
import { getCoreSkills, getSkillGroups } from "../data/skills";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const core = getCoreSkills(lang);
const skillGroups = getSkillGroups(lang);
const t = useTranslations(lang);
---

<section id="skills" class="border-t border-line py-20 sm:py-24 dark:border-dark-line">
  <div class="container-content">
    <div data-reveal>
      <p class="eyebrow mb-3">{t("skills.eyebrow")}</p>
      <h2 class="section-title">{t("skills.title")}</h2>
      <p class="lead mt-4 max-w-2xl">
        {t("skills.lead")}
      </p>
    </div>

    <!-- Core stack: two rows of four on desktop, two columns on mobile. -->
    <h3 class="mt-10 font-mono text-xs uppercase tracking-widest text-muted dark:text-dark-muted" data-reveal>
      {t("skills.core")}
    </h3>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        core.map((c, i) => (
          <div class="card card-hover p-4 sm:p-5" data-reveal style={`--reveal-delay:${(i % 4) * 50}ms`}>
            <span
              class="flex h-10 w-10 items-center justify-center rounded-xl"
              style={`background:${c.color}1c; color:${c.color}`}
            >
              <Icon name={c.icon} class="h-5 w-5" />
            </span>
            <h4 class="mt-3 font-display text-base font-semibold text-ink dark:text-dark-text">{c.name}</h4>
            <p class="mt-1 text-xs leading-relaxed text-muted dark:text-dark-muted">{c.note}</p>
          </div>
        ))
      }
    </div>

    <!-- Everything else, compact. -->
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((g, i) => (
          <div class="card p-4" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
            <h3 class="font-mono text-[0.68rem] uppercase tracking-widest text-muted dark:text-dark-muted">{g.title}</h3>
            <ul class="mt-2.5 flex flex-wrap gap-1.5">
              {g.items.map((s) => (
                <li class="tag">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
