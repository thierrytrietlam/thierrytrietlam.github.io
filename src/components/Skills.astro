---
import { Icon } from "astro-icon/components";
import { getCoreSkills, getSkillGroups } from "../data/skills";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const core = getCoreSkills(lang);
const skillGroups = getSkillGroups(lang);
const t = useTranslations(lang);

// Brand color tints for the core stack icons. Written as literal Tailwind
// classes (keyed by the hex in skills.ts) so the JIT compiler emits them. The
// previous inline style was blocked by the site CSP, which is why the logos
// rendered monochrome. Background mirrors the old #RRGGBB1c (~10% alpha).
const tint: Record<string, string> = {
  "#4386FA": "text-[#4386FA] bg-[#4386FA]/10",
  "#FF694A": "text-[#FF694A] bg-[#FF694A]/10",
  "#64748B": "text-[#64748B] bg-[#64748B]/10",
  "#E97627": "text-[#E97627] bg-[#E97627]/10",
  "#F2C811": "text-[#F2C811] bg-[#F2C811]/10",
  "#29B5E8": "text-[#29B5E8] bg-[#29B5E8]/10",
  "#FF9900": "text-[#FF9900] bg-[#FF9900]/10",
  "#8B5CF6": "text-[#8B5CF6] bg-[#8B5CF6]/10",
};
---

<section id="skills" class="border-t border-line py-20 sm:py-24 dark:border-dark-line">
  <div class="container-content">
    <div data-reveal>
      <p class="eyebrow mb-3">{t("skills.eyebrow")}</p>
      <h2 class="section-title">{t("skills.title")}</h2>
      <p class="lead mt-4 max-w-2xl">
        {t("skills.lead")}
      </p>
    </div>

    <!-- Core stack: two rows of four on desktop, two columns on mobile. -->
    <h3 class="mt-10 font-mono text-xs uppercase tracking-widest text-muted dark:text-dark-muted" data-reveal>
      {t("skills.core")}
    </h3>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        core.map((c, i) => (
          <div class="card card-hover p-4 sm:p-5" data-reveal style={`--reveal-delay:${(i % 4) * 50}ms`}>
            <span class:list={["flex h-10 w-10 items-center justify-center rounded-xl", tint[c.color]]}>
              <Icon name={c.icon} class="h-5 w-5" />
            </span>
            <h4 class="mt-3 font-display text-base font-semibold text-ink dark:text-dark-text">{c.name}</h4>
            <p class="mt-1 text-xs leading-relaxed text-muted dark:text-dark-muted">{c.note}</p>
          </div>
        ))
      }
    </div>

    <!-- Everything else, compact. -->
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((g, i) => (
          <div class="card p-4" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
            <h3 class="font-mono text-[0.68rem] uppercase tracking-widest text-muted dark:text-dark-muted">{g.title}</h3>
            <ul class="mt-2.5 flex flex-wrap gap-1.5">
              {g.items.map((s) => (
                <li class="tag">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
