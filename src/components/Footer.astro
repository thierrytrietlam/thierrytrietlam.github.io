---
import { getSite } from "../data/site";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const site = getSite(lang);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-10 dark:border-dark-line">
  <div class="container-content text-center">
    <p class="font-mono text-xs text-muted dark:text-dark-muted">© {year} {site.name} · {site.eyebrow}</p>
    <p class="mt-1 font-mono text-xs text-muted dark:text-dark-muted">{t("footer.tagline")}</p>
  </div>
</footer>
