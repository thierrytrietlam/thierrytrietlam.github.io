---
import { Icon } from "astro-icon/components";
import { getCertifications } from "../data/timeline";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const certifications = getCertifications(lang);
const t = useTranslations(lang);
---

<section id="certifications" class="border-t border-line py-20 sm:py-24 dark:border-dark-line">
  <div class="container-content">
    <div data-reveal>
      <p class="eyebrow mb-3">{t("certs.eyebrow")}</p>
      <h2 class="section-title">{t("certs.title")}</h2>
      <p class="lead mt-4 max-w-2xl">{t("certs.lead")}</p>
    </div>

    <ul class="mt-10 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        certifications.map((c) => (
          <li>
            <a
              href={c.url}
              target="_blank"
              rel="noopener"
              data-credential-id={c.credentialId}
              title={c.credentialId ? t("certs.copyHint") : undefined}
              class="group flex h-full items-start gap-3 rounded-xl border border-line bg-white p-3.5 transition hover:border-accent hover:shadow-card dark:border-dark-line dark:bg-dark-surface dark:hover:border-accent-dark"
            >
              <Icon name="lucide:award" class="mt-0.5 h-4 w-4 shrink-0 text-accent dark:text-accent-dark" />
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-medium text-ink dark:text-dark-text">{c.name}</span>
                <span class="mt-0.5 block font-mono text-xs text-muted dark:text-dark-muted">
                  {c.issuer} · {c.when}
                </span>
                {c.credentialId && (
                  <span class="mt-0.5 block font-mono text-xs text-muted dark:text-dark-muted">
                    {t("certs.credential")} <span class="text-ink dark:text-dark-text">{c.credentialId}</span>
                    <span data-copied-note class="ml-1.5 hidden text-emerald-500">{t("certs.copied")}</span>
                  </span>
                )}
              </span>
              <Icon
                name="lucide:arrow-up-right"
                class="h-3.5 w-3.5 shrink-0 text-muted opacity-0 transition group-hover:opacity-100 dark:text-dark-muted"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // The ITIL card carries a verifiable certificate number. Clicking it opens the
  // PeopleCert verification page and copies the number so the visitor only pastes.
  document.querySelectorAll<HTMLAnchorElement>("a[data-credential-id]").forEach((link) => {
    link.addEventListener("click", async () => {
      const id = link.dataset.credentialId || "";
      if (!id) return;
      try {
        await navigator.clipboard.writeText(id);
      } catch {
        // Clipboard API unavailable (http, old browser): fall back to a hidden input.
        const input = document.createElement("input");
        input.value = id;
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        input.remove();
      }
      const note = link.querySelector("[data-copied-note]");
      note?.classList.remove("hidden");
      setTimeout(() => note?.classList.add("hidden"), 1600);
    });
  });
</script>
