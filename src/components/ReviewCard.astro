---
import { Icon } from "astro-icon/components";
import type { Recommendation } from "../data/reviews";
import { logoSize } from "../data/logos";

interface Props {
  rec: Recommendation;
  translatedLabel: string;
}
const { rec, translatedLabel } = Astro.props;
const dim = logoSize(rec.logo);
---

<!-- One recommendation. The referee is identified by role and company only,
     never by name. When the quote was written in the other language it stays
     in its original wording and the translation is printed underneath, so a
     reader always sees what was actually written. -->
<figure
  class="card flex h-full min-w-[19rem] max-w-[22rem] shrink-0 snap-start flex-col p-6 sm:min-w-[21rem]"
>
  <div class="flex items-start gap-3">
    {
      rec.logo ? (
        <span class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full border border-line bg-white dark:border-dark-line">
          <img
            src={rec.logo}
            alt={rec.company}
            width={dim?.w}
            height={dim?.h}
            loading="lazy"
            decoding="async"
            class="h-7 w-7 object-contain"
          />
        </span>
      ) : (
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent-soft font-mono text-sm font-medium text-accent dark:bg-dark-bg dark:text-accent-dark">
          {rec.company.slice(0, 2).toUpperCase()}
        </span>
      )
    }
    <span class="min-w-0">
      <span class="block text-sm font-semibold leading-snug text-ink dark:text-dark-text">{rec.role}</span>
      <span class="mt-0.5 block text-xs text-muted dark:text-dark-muted">{rec.company}</span>
    </span>
    <Icon name="lucide:quote" class="ml-auto mt-0.5 h-5 w-5 shrink-0 self-start text-accent/30 dark:text-accent-dark/30" />
  </div>

  <blockquote
    lang={rec.sourceLang}
    class="mt-4 flex-1 text-sm leading-relaxed text-ink dark:text-dark-text"
  >
    {rec.quote}
  </blockquote>

  {
    rec.translation && (
      <p class="mt-3 border-t border-line pt-3 text-xs leading-relaxed text-muted dark:border-dark-line dark:text-dark-muted">
        <span class="font-medium">{translatedLabel}</span> {rec.translation}
      </p>
    )
  }
</figure>
