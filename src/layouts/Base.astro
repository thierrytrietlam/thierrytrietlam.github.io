---
// CV-SYNC | CV source of truth: c:/Users/lammi/endeavor/en.tex (EN), c:/Users/lammi/endeavor/fr.tex (FR).
// CV-SYNC | This file repeats CV facts. Edit the .tex first, then propagate here.
// CV-SYNC | Full propagation list: search CV-SYNC-REGISTRY inside either .tex file.

import { SEO } from "astro-seo";
import { getSite } from "../data/site";
import { getLangFromUrl, getAltPath } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

// Self hosted fonts (only the weights used)
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const site = getSite(lang);
const t = useTranslations(lang);

// Kept under ~60 chars (title) and ~155 chars (description) so search
// snippets show them uncut.
const defaultTitle =
  lang === "fr"
    ? `${site.name} · Ingénieur Analytics Senior, Paris`
    : `${site.name} · Senior Analytics Engineer, Paris`;
const defaultDescription =
  lang === "fr"
    ? "Ingénieur analytics senior à Paris. dbt, BigQuery, Snowflake, IA au quotidien. Cinq ans à piloter des plateformes data pour 9 entreprises dans 4 pays."
    : "Senior analytics engineer in Paris. dbt, BigQuery, Snowflake, AI in the workflow. Five years owning data platforms for 9 companies across 4 countries.";

const { title = defaultTitle, description = defaultDescription } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/og.png", Astro.site).toString();
const enHref = new URL(getAltPath(Astro.url, "en"), Astro.site).toString();
const frHref = new URL(getAltPath(Astro.url, "fr"), Astro.site).toString();
const ogLocale = lang === "fr" ? "fr_FR" : "en_US";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: ["Thierry Lam", "Triet Lam", "Thierry Triet Lam"],
  jobTitle: lang === "fr" ? "Ingénieur Analytics Senior" : "Senior Analytics Engineer",
  description,
  url: Astro.site?.toString(),
  image: new URL("/img/profile.jpg", Astro.site).toString(),
  email: `mailto:${site.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Paris",
    addressCountry: "FR",
  },
  knowsLanguage: ["French", "English", "Vietnamese"],
  knowsAbout: [
    "Analytics Engineering",
    "Data Engineering",
    "Data Platform Architecture",
    "Data Modeling",
    "Data Governance",
    "Data Quality",
    "Business Intelligence",
    "dbt",
    "BigQuery",
    "Snowflake",
    "SQL",
    "Python",
    "Power BI",
    "Tableau",
    "Airflow",
  ],
  sameAs: [site.links.linkedin, site.links.github],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {site.googleSiteVerification && (
      <meta name="google-site-verification" content={site.googleSiteVerification} />
    )}
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="fr" href={frHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta name="theme-color" content="#FBFBFD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A0F1A" media="(prefers-color-scheme: dark)" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: { title, type: "website", image: ogImage, url: canonical },
        optional: { description, siteName: site.name, locale: ogLocale },
        image: { alt: `${site.name}, ${site.eyebrow}`, width: 1200, height: 630 },
      }}
      twitter={{
        card: "summary_large_image",
        image: ogImage,
        imageAlt: `${site.name}, ${site.eyebrow}`,
        title,
        description,
      }}
    />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Apply the saved theme before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          var dark =
            t === "dark" ||
            (!t && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t("a11y.skip")}</a>
    <slot />

    <!-- mailto fallback: shown when no email app handles the click. -->
    <div
      id="mailto-fallback"
      role="status"
      aria-live="polite"
      class="fixed bottom-5 left-1/2 z-50 hidden w-[calc(100%-2rem)] max-w-md -translate-x-1/2 rounded-xl border border-line bg-white p-4 shadow-card dark:border-dark-line dark:bg-dark-surface"
    >
      <div class="flex items-start gap-3">
        <p class="min-w-0 flex-1 text-sm text-ink dark:text-dark-text">
          {t("contact.mailFallback")}
          <span class="mt-1 block truncate font-mono text-[0.8rem] font-semibold" data-mf-email></span>
        </p>
        <button
          type="button"
          data-mf-close
          aria-label={t("contact.mailFallbackClose")}
          class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-line text-muted transition hover:border-accent hover:text-accent dark:border-dark-line dark:text-dark-muted dark:hover:border-accent-dark dark:hover:text-accent-dark"
        >×</button>
      </div>
      <a
        data-mf-gmail
        href="https://mail.google.com/"
        target="_blank"
        rel="noopener"
        class="btn btn-ghost mt-3 h-9 w-full text-sm"
      >{t("contact.mailFallbackGmail")}</a>
    </div>

    <!-- mailto links fail silently when no mail app is registered (common on
         Windows with webmail). Detect the unhandled click: if the window never
         loses focus, copy the address and surface the fallback card. -->
    <script>
      const fb = document.getElementById("mailto-fallback");
      const fbEmail = fb?.querySelector<HTMLElement>("[data-mf-email]");
      const fbGmail = fb?.querySelector<HTMLAnchorElement>("[data-mf-gmail]");
      let fbTimer: number | undefined;
      const hideFb = () => {
        fb?.classList.add("hidden");
        if (fbTimer) window.clearTimeout(fbTimer);
      };
      fb?.querySelector("[data-mf-close]")?.addEventListener("click", hideFb);

      const copyText = async (text: string) => {
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const input = document.createElement("input");
          input.value = text;
          document.body.appendChild(input);
          input.select();
          document.execCommand("copy");
          input.remove();
        }
      };

      document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"]').forEach((a) => {
        a.addEventListener("click", () => {
          const [addr, query] = a.href.replace(/^mailto:/, "").split("?");
          const email = decodeURIComponent(addr);
          const subject = new URLSearchParams(query || "").get("subject") || "";
          let handled = false;
          const onAway = () => {
            handled = true;
          };
          window.addEventListener("blur", onAway, { once: true });
          document.addEventListener("visibilitychange", onAway, { once: true });
          window.setTimeout(() => {
            window.removeEventListener("blur", onAway);
            document.removeEventListener("visibilitychange", onAway);
            if (handled || document.visibilityState === "hidden" || !fb) return;
            copyText(email);
            if (fbEmail) fbEmail.textContent = email;
            if (fbGmail)
              fbGmail.href = `https://mail.google.com/mail/?view=cm&fm=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent(subject)}`;
            fb.classList.remove("hidden");
            if (fbTimer) window.clearTimeout(fbTimer);
            fbTimer = window.setTimeout(hideFb, 12000);
          }, 900);
        });
      });
    </script>

    <!-- Scroll reveal: enhance only when motion is allowed. -->
    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (!reduce.matches) {
        document.documentElement.classList.add("js-reveal");
        const els = document.querySelectorAll("[data-reveal]");
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
